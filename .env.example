PORT=3000
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=14d
# 프론트 개발 서버 주소입니다. 여러 주소가 필요하면 쉼표로 구분합니다.
FRONTEND_URL=http://localhost:5173
# 운영에서는 true로 설정합니다. HTTPS에서만 refresh token 쿠키를 전송합니다.
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/callback/google
# Google OAuth state를 잠시 보관하는 서버 세션의 서명 키입니다. JWT secret과 다른 32자 이상 값입니다.
OAUTH_SESSION_SECRET=
GEMINI_TIMEOUT_MS=60000
GEMINI_API_KEY=
RECOMMENDATION_STANDALONE_ENABLED=false
TOUR_API_SERVICE_KEY=
GOOGLE_MAPS_API_KEY=

# npm run prisma:seed 실행 시에만 사용하는 프론트 연동 테스트 계정입니다.
# 실제 값은 Railway Variables 또는 로컬 .env에만 저장하고 Git에 올리지 않습니다.
SEED_TEST_EMAIL=
SEED_TEST_PASSWORD=
SEED_TEST_NICKNAME=Idolog 테스트

# 기본 Excel은 prisma/data에 포함되어 있습니다.
# 다른 파일로 교체할 때만 로컬 절대 경로를 설정합니다.
CONTENT_EXCEL_PATH=

# TAXI/CAR 자동차 길찾기: 카카오모빌리티 사용 권한이 있는 REST API 키
KAKAO_MOBILITY_API_KEY=
