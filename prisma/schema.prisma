generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum LocationCategory {
  MV_SPOT
  CAFE
  PHOTO_SPOT
}

model User {
  id                BigInt        @id @default(autoincrement())
  email             String        @unique
  passwordHash      String?
  // refresh token 원문 대신 bcrypt 해시만 보관해 로그아웃·토큰 교체 시 폐기할 수 있습니다.
  refreshTokenHash  String?
  googleSub         String?       @unique
  nickname          String?
  preferredLanguage String
  provider          AuthProvider
  savedCourses      SavedCourse[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

/**
 * Excel의 제목 컬럼(아티스트명)을 기준으로 생성하는 아이돌/아티스트입니다.
 */
model Idol {
  id          BigInt       @id @default(autoincrement())
  name        String       @unique
  agency      String?
  imageUrl    String?
  musicVideos MusicVideo[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

/**
 * Excel에서 보완한 뮤직비디오 제목·YouTube 링크를 저장합니다.
 * releaseDate는 원본 Excel에 없으므로 나중에 별도 데이터로 채웁니다.
 */
model MusicVideo {
  id             BigInt                      @id @default(autoincrement())
  title          String
  releaseDate    DateTime?
  youtubeUrl     String?
  sourceLinkType String?
  idolId         BigInt
  idol           Idol                        @relation(fields: [idolId], references: [id], onDelete: Cascade)
  locations      MusicVideoFilmingLocation[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([idolId, title])
}

/**
 * 한국문화정보원 촬영지 Excel의 한 행을 보존하는 장소입니다.
 * sourceId는 원본 연번이므로 같은 Excel을 다시 import해도 중복 생성되지 않습니다.
 */
model FilmingLocation {
  id              BigInt                      @id @default(autoincrement())
  sourceId        Int                         @unique
  name            String
  category        LocationCategory
  sourcePlaceType String
  description     String?
  businessHours   String?
  closedDays      String?
  address         String
  latitude        Float
  longitude       Float
  phoneNumber     String?
  sourceUpdatedAt DateTime?
  imageUrl        String?
  musicVideos     MusicVideoFilmingLocation[]
  savedCourses    SavedCourse[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
}

/**
 * 뮤직비디오와 촬영지의 다대다 관계입니다.
 */
model MusicVideoFilmingLocation {
  musicVideoId      BigInt
  filmingLocationId BigInt
  musicVideo        MusicVideo      @relation(fields: [musicVideoId], references: [id], onDelete: Cascade)
  filmingLocation   FilmingLocation @relation(fields: [filmingLocationId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@id([musicVideoId, filmingLocationId])
  @@index([filmingLocationId])
}

/**
 * 사용자가 저장해 둔 추천 코스입니다.
 * 코스를 만든 것은 AI 에이전트라 그 결과를 그대로 보관합니다. TourAPI 장소를
 * 참조로 두지 않고 값을 복사해 담는 것은 의도한 것입니다. contentId 는 언어별
 * 서비스마다 다른 값이라 참조로 두면 언어를 바꾼 순간 저장한 코스가 빈 껍데기가
 * 되고, 외부 데이터가 바뀌면 지난 여행 기록까지 따라 바뀝니다.
 */
model SavedCourse {
  id                    BigInt             @id @default(autoincrement())
  // 에이전트가 코스에 붙인 식별자입니다. 같은 코스를 다시 저장해도 늘지 않도록
  // 사용자와 묶어 유일성을 겁니다.
  courseKey             String
  userId                BigInt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 코스의 출발점이 된 촬영지입니다.
  filmingLocationId     BigInt
  filmingLocation       FilmingLocation    @relation(fields: [filmingLocationId], references: [id], onDelete: Cascade)
  title                 String
  summary               String
  reason                String
  totalDistanceMeters   Int
  totalDurationSeconds  Int
  travelDurationSeconds Int?
  // "HH:mm" 문자열입니다. 날짜가 없는 시각이라 DateTime 으로 두면 없는 날짜가 붙습니다.
  startTime             String?
  endTime               String?
  places                SavedCoursePlace[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([userId, courseKey])
  @@index([userId])
}

/**
 * 코스 안의 방문 장소입니다. order 오름차순으로 이동합니다.
 */
model SavedCoursePlace {
  id                      BigInt      @id @default(autoincrement())
  savedCourseId           BigInt
  savedCourse             SavedCourse @relation(fields: [savedCourseId], references: [id], onDelete: Cascade)
  order                   Int
  name                    String
  address                 String
  latitude                Float
  longitude               Float
  imageUrl                String?
  overview                String?
  homepageUrl             String?
  arrivalTime             String?
  category                String?
  // 첫 장소는 이전 구간이 없어 둘 다 비어 있습니다.
  distanceFromPrevMeters  Int?
  durationFromPrevSeconds Int?

  @@unique([savedCourseId, order])
}
